# Inference Service 环境配置

# 服务配置
INFERENCE_PORT=13111

# 模型配置
MODEL_PATH=models/
MODEL_EXISTS=true

# 允许的后端服务（CORS白名单）
# 支持所有服务访问：设置为 * 或使用逗号分隔的多个URL
# 示例：CORS_ALLOW_ORIGINS=* 或 CORS_ALLOW_ORIGINS=http://localhost:8080,http://192.168.1.100:8080
CORS_ALLOW_ORIGINS=*
BACKEND_SERVICE_URL=http://localhost:8080

# 日志配置
LOG_LEVEL=INFO
